{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfkit/js/data/**"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }]
}
